<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The H.264 encoder of Matgate's own display engine is called through function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <VersionPrefix>0.62.1</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <!-- xterm.js for the agent terminals, served from the gateway itself (no CDN). -->
    <EmbeddedResource Include="Web/Assets/xterm/*" LogicalName="xterm/%(Filename)%(Extension)" />
    <!-- CodeMirror 6 for the database browser's editor, one file built from npm (Web/Assets/codemirror/build). -->
    <EmbeddedResource Include="Web/Assets/codemirror/*" LogicalName="codemirror/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The remote engine (RDP, VNC, sound, H.264), shared with ThixGate. -->
    <ProjectReference Include="..\Mat.Remote\Mat.Remote.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

</Project>
