<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for Matgate's own VNC client (Matgate/Display/Vnc). The sources are compiled into this project
       directly, so the tests reach the internal parts - the decoders, the DES - as well.

         dotnet test tests/unit/Vnc.Tests

       runs everything that needs no server: the DES against known answers, every decoder against rectangles
       encoded by hand, truncated and random input, and the whole client against a scripted server on the
       loopback interface.

       The tests in ServerTests.cs talk to real VNC servers and skip themselves unless MATGATE_VNC_TEST_HOST
       is set; the comment at the top of that file says which servers they expect and how to run them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Matgate.Display.Vnc.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\..\Matgate\Display\Vnc\**\*.cs" LinkBase="Vnc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

</Project>
