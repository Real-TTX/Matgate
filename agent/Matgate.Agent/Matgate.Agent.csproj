<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- A windowed exe: a double-click opens the setup dialog without a console behind it. Commands
         typed in a console still print there (see AgentLog.AttachToParentConsole). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>matgate-agent</AssemblyName>
    <RootNamespace>Matgate.Agent</RootNamespace>
    <VersionPrefix>0.6.0</VersionPrefix>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>matgate-agent.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish -r win-x64: one self-contained file, which is what the setup copies. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.*" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wire format lives in the gateway project and is compiled into both, so the two sides
         cannot drift apart. -->
    <Compile Include="..\..\Matgate\Agent\AgentWire.cs" Link="AgentWire.cs" />
  </ItemGroup>

</Project>
