<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>matgate-agent</AssemblyName>
    <RootNamespace>Matgate.Agent</RootNamespace>
    <VersionPrefix>0.1.0</VersionPrefix>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The wire format lives in the gateway project and is compiled into both, so the two sides
         cannot drift apart. -->
    <Compile Include="..\..\Matgate\Agent\AgentWire.cs" Link="AgentWire.cs" />
  </ItemGroup>

</Project>
