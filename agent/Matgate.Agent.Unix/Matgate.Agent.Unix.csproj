<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The agent for Linux and macOS: the same server as the Windows program, from the same source files -
    whatever talks to Matgate (the connection, files, terminals, the logo) is linked from ../Matgate.Agent,
    what belongs to the system (pseudo terminals, the service, updates) is here.

    dotnet publish -r linux-x64 | linux-arm64 | osx-arm64 | osx-x64: one self-contained file, matgate-agent.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>matgate-agent</AssemblyName>
    <RootNamespace>Matgate.Agent</RootNamespace>
    <!-- The same number as the Windows program: one release, every system. -->
    <VersionPrefix>0.11.0</VersionPrefix>
    <!-- The linked files call a few Windows-only functions behind OperatingSystem.IsWindows(). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Matgate\Agent\AgentWire.cs" Link="Shared\AgentWire.cs" />
    <Compile Include="..\Matgate.Agent\AgentServices.cs" Link="Shared\AgentServices.cs" />
    <Compile Include="..\Matgate.Agent\AgentConfig.cs" Link="Shared\AgentConfig.cs" />
    <Compile Include="..\Matgate.Agent\AgentLogo.cs" Link="Shared\AgentLogo.cs" />
    <Compile Include="..\Matgate.Agent\AgentCertificate.cs" Link="Shared\AgentCertificate.cs" />
    <Compile Include="..\Matgate.Agent\AgentLog.cs" Link="Shared\AgentLog.cs" />
    <Compile Include="..\Matgate.Agent\AgentStatus.cs" Link="Shared\AgentStatus.cs" />
    <Compile Include="..\Matgate.Agent\AgentVersion.cs" Link="Shared\AgentVersion.cs" />
    <Compile Include="..\Matgate.Agent\Connection.cs" Link="Shared\Connection.cs" />
    <Compile Include="..\Matgate.Agent\FilesPlugin.cs" Link="Shared\FilesPlugin.cs" />
    <Compile Include="..\Matgate.Agent\TerminalPlugin.cs" Link="Shared\TerminalPlugin.cs" />
  </ItemGroup>

</Project>
