# OPTIONAL. Matgate now auto-generates its secrets on first `docker compose up` (see the "secrets"
# service in docker-compose.yml), so a plain deploy works with NO .env at all.
#
# Only create a `.env` (copy this file) if you want to PIN the secrets yourself - e.g. to share the
# same values across hosts, or to keep the at-rest key in your own secret store. Any value set here
# overrides the auto-generated one.

# Shared Guacamole JSON-auth key (matgate signs, guacamole verifies). Exactly 32 hex chars:
#   openssl rand -hex 16
# MATGATE_GUACAMOLE_JSON_SECRET_KEY=

# At-rest encryption key for stored device credentials (servers.json). Keep it safe/backed up - if
# you pin it here and lose it, the encrypted credentials can't be decrypted. Generate with:
#   openssl rand -hex 32
# MATGATE_SECRET_KEY=

# First-run admin password (only used to seed the initial admin account; ignored afterwards).
# MATGATE_ADMIN_PASSWORD=change-me-please

# Set to true once TLS is terminated at the edge to force Secure-only cookies + HSTS + HTTPS redirect.
# MATGATE_REQUIRE_HTTPS=false
